<p>
    <label for="{{ fields.title.id }}">{{ __('Titre :') }}</label>
    <input class="widefat" id="{{ fields.title.id }}" name="{{ fields.title.name }}" type="text" value="{{ instance.title }}">
</p>
{% if accounts|length > 1 %}
<p>
    <label for="{{ fields.page.id }}">{{ __('Page :') }}</label>
    <select class="widefat" id="{{ fields.page.id }}" name="{{ fields.page.name }}">
        <option value="all" {{ instance.page == 'all' ? 'selected' }}>{{ __('Toutes les Pages') }}</option>
        {% for account in accounts %}
            <option value="{{ account.id }}" {{ instance.page == account.id ? 'selected' }}>
                {{ account.name }}{% if account.hasInstagram %} (@{{ account.igUsername }}){% endif %}
            </option>
        {% endfor %}
    </select>
</p>
{% endif %}
<p>
    <label for="{{ fields.source.id }}">{{ __('Source :') }}</label>
    <select class="widefat" id="{{ fields.source.id }}" name="{{ fields.source.name }}">
        {% for value, label in { all: __('Facebook + Instagram'), facebook: 'Facebook', instagram: 'Instagram' } %}
            <option value="{{ value }}" {{ instance.source == value ? 'selected' }}>{{ label }}</option>
        {% endfor %}
    </select>
</p>
<p>
    <label for="{{ fields.columns.id }}">{{ __('Par ligne :') }}</label>
    <input class="tiny-text" id="{{ fields.columns.id }}" name="{{ fields.columns.name }}" type="number" min="1" max="6" value="{{ instance.columns }}">
    &nbsp;
    <label for="{{ fields.rows.id }}">{{ __('Lignes :') }}</label>
    <input class="tiny-text" id="{{ fields.rows.id }}" name="{{ fields.rows.name }}" type="number" min="1" max="10" value="{{ instance.rows }}">
</p>
<p>
    <input class="checkbox" id="{{ fields.featured.id }}" name="{{ fields.featured.name }}" type="checkbox" value="1" {{ instance.featured ? 'checked' }}>
    <label for="{{ fields.featured.id }}">{{ __('Première publication en pleine largeur') }}</label>
</p>
<p>
    <input class="checkbox" id="{{ fields.pagination.id }}" name="{{ fields.pagination.name }}" type="checkbox" value="1" {{ instance.pagination ? 'checked' }}>
    <label for="{{ fields.pagination.id }}">{{ __('Publications suivantes / précédentes') }}</label>
</p>
<p>
    <input class="checkbox" id="{{ fields.follow.id }}" name="{{ fields.follow.name }}" type="checkbox" value="1" {{ instance.follow ? 'checked' }}>
    <label for="{{ fields.follow.id }}">{{ __('Liens « Nous suivre » avec les abonnés') }}</label>
</p>
<p>
    <label for="{{ fields.layout.id }}">{{ __('Disposition :') }}</label>
    <select id="{{ fields.layout.id }}" name="{{ fields.layout.name }}">
        <option value="grid" {{ instance.layout == 'grid' ? 'selected' }}>{{ __('Grille') }}</option>
        <option value="list" {{ instance.layout == 'list' ? 'selected' }}>{{ __('Liste') }}</option>
    </select>
</p>
<p>
    <input class="checkbox" id="{{ fields.show_text.id }}" name="{{ fields.show_text.name }}" type="checkbox" value="1" {{ instance.show_text ? 'checked' }}>
    <label for="{{ fields.show_text.id }}">{{ __('Afficher le texte') }}</label>
</p>
