<div class="wrap">
    <h1>Rezos</h1>

    {% if notice %}
        <div class="notice notice-{{ notice.type }} is-dismissible"><p>{{ notice.message }}</p></div>
    {% endif %}

    {# ─── 1. Application Meta ─────────────────────────────── #}
    <h2>{{ __('1. Application Meta') }}</h2>
    <p class="description">
        {{ __('Créez une application de type « Business » sur developers.facebook.com, puis renseignez ses identifiants.') }}
    </p>
    <form method="post" action="{{ post_url }}">
        <input type="hidden" name="action" value="rezos_save">
        {{ wp_nonce_field('rezos_save') }}
        <table class="form-table" role="presentation">
            <tr>
                <th scope="row"><label for="rezos-app-id">App ID</label></th>
                <td><input id="rezos-app-id" name="app_id" type="text" class="regular-text" value="{{ settings.app_id }}" autocomplete="off"></td>
            </tr>
            <tr>
                <th scope="row"><label for="rezos-app-secret">App Secret</label></th>
                <td>
                    <input id="rezos-app-secret" name="app_secret" type="password" class="regular-text" value="" autocomplete="new-password"
                           placeholder="{{ settings.app_secret ? '••••••••  (' ~ __('enregistré') ~ ')' : '' }}">
                    <p class="description">{{ __('Laissez vide pour conserver la valeur actuelle.') }}</p>
                </td>
            </tr>
            <tr>
                <th scope="row"><label for="rezos-version">{{ __('Version Graph API') }}</label></th>
                <td><input id="rezos-version" name="graph_version" type="text" class="small-text" value="{{ settings.graph_version }}"></td>
            </tr>
            <tr>
                <th scope="row"><label for="rezos-ttl">{{ __('Durée du cache (secondes)') }}</label></th>
                <td><input id="rezos-ttl" name="cache_ttl" type="number" min="300" step="60" class="small-text" value="{{ settings.cache_ttl }}"></td>
            </tr>
            <tr>
                <th scope="row"><label for="rezos-limit">{{ __('Nombre de publications par défaut') }}</label></th>
                <td><input id="rezos-limit" name="default_limit" type="number" min="1" max="50" class="small-text" value="{{ settings.default_limit }}"></td>
            </tr>
        </table>
        <p><button type="submit" class="button button-primary">{{ __('Enregistrer') }}</button></p>
    </form>

    <hr>

    {# ─── 2. Pages Facebook et comptes Instagram ──────────── #}
    <h2>{{ __('2. Pages Facebook et comptes Instagram') }}</h2>

    {% if pending is not empty %}
        {# Choix des Pages après connexion (plusieurs Pages accessibles) #}
        <p>{{ __('Cochez les Pages à afficher sur le site. Les Pages décochées seront retirées.') }}</p>
        <form method="post" action="{{ post_url }}">
            <input type="hidden" name="action" value="rezos_select_pages">
            {{ wp_nonce_field('rezos_select_pages') }}
            <fieldset>
                {% set connected_ids = accounts|map(a => a.id) %}
                {% for page in pending %}
                    <label style="display:block;margin:.4em 0">
                        <input type="checkbox" name="page_ids[]" value="{{ page.id }}"
                               {{ connected_ids is empty or page.id in connected_ids ? 'checked' }}>
                        <strong>{{ page.name }}</strong>
                        {% if page.ig_username %}— Instagram @{{ page.ig_username }}{% endif %}
                    </label>
                {% endfor %}
            </fieldset>
            <p><button type="submit" class="button button-primary">{{ __('Enregistrer la sélection') }}</button></p>
        </form>
        <hr>
    {% endif %}

    {% if connected %}
        <table class="widefat striped" style="max-width:900px">
            <thead>
                <tr>
                    <th>{{ __('Page Facebook') }}</th>
                    <th>Instagram</th>
                    <th>{{ __('Shortcode') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for account in accounts %}
                    <tr>
                        <td><strong>{{ account.name }}</strong><br><small>ID {{ account.id }}</small></td>
                        <td>
                            {% if account.hasInstagram %}
                                @{{ account.igUsername }}
                            {% else %}
                                <span title="{{ __('Aucun compte Instagram professionnel lié à cette Page.') }}">—</span>
                            {% endif %}
                        </td>
                        <td><code>[rezos page="{{ account.id }}"]</code></td>
                        <td>
                            <form method="post" action="{{ post_url }}">
                                <input type="hidden" name="action" value="rezos_remove_page">
                                <input type="hidden" name="page_id" value="{{ account.id }}">
                                {{ wp_nonce_field('rezos_remove_page') }}
                                <button type="submit" class="button-link button-link-delete">{{ __('Retirer') }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <div style="margin:1em 0">
            <form method="post" action="{{ post_url }}" style="display:inline">
                <input type="hidden" name="action" value="rezos_test">
                {{ wp_nonce_field('rezos_test') }}
                <button type="submit" class="button">{{ __('Tester la connexion') }}</button>
            </form>
            <form method="post" action="{{ post_url }}" style="display:inline">
                <input type="hidden" name="action" value="rezos_flush">
                {{ wp_nonce_field('rezos_flush') }}
                <button type="submit" class="button">{{ __('Vider le cache') }}</button>
            </form>
            <form method="post" action="{{ post_url }}" style="display:inline">
                <input type="hidden" name="action" value="rezos_disconnect">
                {{ wp_nonce_field('rezos_disconnect') }}
                <button type="submit" class="button button-link-delete">{{ __('Tout déconnecter') }}</button>
            </form>
        </div>
        <h3>{{ __('Ajouter ou mettre à jour des Pages') }}</h3>
    {% endif %}

    <ol>
        <li>{{ __('Ouvrez l’Explorateur de l’API Graph (developers.facebook.com/tools/explorer) et sélectionnez votre application.') }}</li>
        <li>{{ __('Ajoutez les autorisations :') }}
            <code>pages_show_list</code>, <code>pages_read_engagement</code>,
            <code>instagram_basic</code>, <code>business_management</code>.</li>
        <li>{{ __('Générez un « User Token » et collez-le ci-dessous. Toutes les Pages accessibles avec ce token vous seront proposées ; chacune reçoit un token de Page sans expiration.') }}</li>
    </ol>
    <form method="post" action="{{ post_url }}">
        <input type="hidden" name="action" value="rezos_connect">
        {{ wp_nonce_field('rezos_connect') }}
        <p>
            <label for="rezos-user-token" class="screen-reader-text">User Token</label>
            <textarea id="rezos-user-token" name="user_token" rows="3" class="large-text code" autocomplete="off"
                      {{ settings.app_id and settings.app_secret ? '' : 'disabled' }}></textarea>
        </p>
        <p><button type="submit" class="button button-primary"
                {{ settings.app_id and settings.app_secret ? '' : 'disabled' }}>{{ __('Connecter') }}</button></p>
        {% if not (settings.app_id and settings.app_secret) %}
            <p class="description">{{ __('Enregistrez d’abord l’App ID et l’App Secret.') }}</p>
        {% endif %}
    </form>

    <hr>

    {# ─── 3. Utilisation ──────────────────────────────────── #}
    <h2>{{ __('3. Utilisation') }}</h2>
    <p>{{ __('Insérez le shortcode dans une page, ou ajoutez le widget « Rezos » dans Apparence > Widgets.') }}</p>
    <table class="widefat striped" style="max-width:900px">
        <thead><tr><th>{{ __('Attribut') }}</th><th>{{ __('Valeurs') }}</th><th>{{ __('Défaut') }}</th></tr></thead>
        <tbody>
            <tr><td><code>page</code></td><td>{{ __('IDs de Pages et/ou comptes Instagram (@nom), séparés par des virgules') }}</td><td><code>all</code></td></tr>
            <tr><td><code>source</code></td><td><code>all</code>, <code>facebook</code>, <code>instagram</code>, <code>facebook,instagram</code></td><td><code>all</code></td></tr>
            <tr><td><code>limit</code></td><td>1 – 50</td><td>{{ settings.default_limit }}</td></tr>
            <tr><td><code>layout</code></td><td><code>grid</code>, <code>list</code></td><td><code>grid</code></td></tr>
            <tr><td><code>columns</code></td><td>1 – 6</td><td>3</td></tr>
            <tr><td><code>type</code></td><td><code>image</code>, <code>video</code>, <code>album</code>, <code>text</code></td><td>{{ __('tous') }}</td></tr>
            <tr><td><code>show_text</code> / <code>show_date</code> / <code>show_stats</code></td><td><code>true</code>, <code>false</code></td><td>true / true / false</td></tr>
            <tr><td><code>show_account</code></td><td><code>true</code>, <code>false</code>, <code>auto</code></td><td><code>auto</code> ({{ __('affiché si plusieurs Pages') }})</td></tr>
            <tr><td><code>excerpt</code></td><td>{{ __('nb de caractères (0 = texte complet)') }}</td><td>140</td></tr>
            <tr><td><code>template</code></td><td>{{ __('fichier Twig du thème (dossier rezos/)') }}</td><td><code>feed.html.twig</code></td></tr>
        </tbody>
    </table>
    <p><code>[rezos source="instagram" limit="6" columns="3"]</code><br>
       <code>[rezos page="@moncompte,123456789" show_stats="true"]</code></p>
</div>
