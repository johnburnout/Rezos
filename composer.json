{
    "name": "jean/rezos",
    "description": "Plugin WordPress : affiche les publications Facebook et Instagram d'une Page sur le site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "symfony/http-client": "^6.4",
        "symfony/options-resolver": "^6.4",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Rezos\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
